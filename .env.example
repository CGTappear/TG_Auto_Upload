# .env.example
# 将此文件复制为 .env 并填写实际值

# 必需：Telegram Bot Token（bot 父级账号在 @BotFather 获取）
BOT_TOKEN=123456:ABC-DEFghIJKlmNoPQRsTUV_wxyz

# 可选：如果你在 docker-compose 中启用了本地 telegram-bot-api 服务
# 将 TELEGRAM_API_BASE 设置为 http://telegram-bot-api:8081（docker-compose.yml 示例）
TELEGRAM_API_BASE=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 监听目录（容器内路径），也可以通过 docker-compose.yml 的 environment 覆盖
PICTURES_DIR=/data/pictures
VIDEOS_DIR=/data/videos
MUSIC_DIR=/data/music

# 宿主机路径（仅用于提示/参考；在 docker-compose 中将宿主机目录挂载到上面的容器路径）
PICTURES_HOST_DIR="D:/Pictures"
VIDEOS_HOST_DIR="D:/videos"
MUSIC_HOST_DIR="D:/Music"

# 对应频道/群组的 chat_id（示例格式：-1001234567890）
PICTURES_CHAT_ID=-1003502902643
VIDEOS_CHAT_ID=-1003807689008
MUSIC_CHAT_ID=-1003956905596

# 启动时是否扫描已有文件（true / false），默认 false（只监听新增/修改）
PICTURES_SCAN_EXISTING=false
VIDEOS_SCAN_EXISTING=false
MUSIC_SCAN_EXISTING=false

# 已上传记录文件（容器内路径），建议在 docker-compose 中挂载到宿主机以持久化）
DB_FILE=/app/state/uploaded_files.json

# 其它可调节项（按需在脚本中实现配置化）
# UPLOAD_TIMEOUT=1200
# STABLE_CHECKS=3
# MAX_WAIT_SECONDS=300
