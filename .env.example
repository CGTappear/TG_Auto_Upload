# .env.example
# 将此文件复制为 .env 并填写实际值

# 必需：Telegram Bot Token（bot 父级账号在 @BotFather 获取）
BOT_TOKEN=123456:ABC-DEFghIJKlmNoPQRsTUV_wxyz

# 可选：如果你在 docker-compose 中启用了本地 telegram-bot-api 服务
# 将 TELEGRAM_API_BASE 设置为 http://telegram-bot-api:8081（docker-compose.yml 示例）
TELEGRAM_API_BASE=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# 代理：让容器通过宿主机的系统代理（Clash / v2rayN 等）访问 Telegram
# 宿主机代理需开启“允许局域网连接 (Allow LAN)”
# host.docker.internal 指向宿主机；端口改成你代理软件的 HTTP/混合端口
# 支持 http:// 和 socks5h://（socks5h 由代理端解析域名，推荐）
PROXY_URL=http://host.docker.internal:7890
# 不走代理的地址，默认跳过本地 telegram-bot-api 容器
NO_PROXY=localhost,127.0.0.1,telegram-bot-api

# 监听目录（容器内路径），也可以通过 docker-compose.yml 的 environment 覆盖
PICTURES_DIR=/data/pictures
VIDEOS_DIR=/data/videos
MUSIC_DIR=/data/music

# 宿主机路径（仅用于提示/参考；在 docker-compose 中将宿主机目录挂载到上面的容器路径）
PICTURES_HOST_DIR="D:/Pictures"
VIDEOS_HOST_DIR="D:/videos"
MUSIC_HOST_DIR="D:/Music"

# 对应频道/群组的 chat_id（示例格式：-1001234567890）
PICTURES_CHAT_ID=-1003502902643
VIDEOS_CHAT_ID=-1003807689008
MUSIC_CHAT_ID=-1003956905596

# 说明：所有目录中「从未上传成功」的文件都会上传（包括启动前已存在的文件），
# 已上传过的文件（按内容 SHA256 判断）不会重复上传

# 已上传记录文件（容器内路径），建议在 docker-compose 中挂载到宿主机以持久化）
DB_FILE=/app/state/uploaded_files.json

# 文件索引（容器内路径），默认与 DB_FILE 同目录的 file_index.json
# 记录每个文件的大小和修改时间，未变化的文件扫描时直接跳过，不再重复计算哈希
# INDEX_FILE=/app/state/file_index.json

# 其它可调节项
# 定时扫描间隔（秒），用于补传漏掉的文件、重试失败的文件
# SCAN_INTERVAL=60
# 单次上传超时（秒）
# UPLOAD_TIMEOUT=1200
# 文件大小连续多少次（每秒一次）不变才认为写入完成
# STABLE_CHECKS=3
# 等待文件写入完成的最长时间（秒）
# MAX_WAIT_SECONDS=300
# 单文件上传上限（MB），默认官方 API 为 50，本地 telegram-bot-api 为 2000；超出的文件跳过且不再重试
# MAX_UPLOAD_MB=2000
